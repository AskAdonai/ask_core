# Upload only what Cloud Functions need at runtime:
#   package.json, yarn.lock, lib/ (compiled JS + lib/seed/morningGreetings.json)
# Run `npx tsc` in functions/ before deploy (deploy.sh does this).

# ── Dependencies (reinstalled on GCP) ──────────────────────────────────────
node_modules/
**/node_modules/

# ── Secrets & local config ───────────────────────────────────────────────────
.env
**/.env
**/*.env
.env.yaml
**/.env.yaml
.env.example
**/.env.example

# ── TypeScript sources (compiled locally → lib/) ─────────────────────────────
src/

# ── Tests & coverage ─────────────────────────────────────────────────────────
test/
coverage/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# ── Dev scripts & one-off tooling ───────────────────────────────────────────
scripts/
seed_*.ts
seed_*.js
seed_firestore.ts
verify_*.ts
verify_*.js
set_cors.ts
injectSwagger.js
tsconfig.json
jest.config.ts
.eslintrc*
.prettierrc*
prettier.config.*

# ── Docs & repo metadata ───────────────────────────────────────────────────────
**/*.md
.gitignore
.github/

# ── Duplicate lockfile (project uses yarn.lock) ───────────────────────────────
package-lock.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Compiled dev-only output (not imported by lib/index.js) ──────────────────
lib/server.js
lib/config/
lib/seed/*.js
