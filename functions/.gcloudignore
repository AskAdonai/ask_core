# Never upload node_modules — GCP Cloud Build installs them fresh from package.json
node_modules/
**/node_modules/

# Secrets and local config — runtime env comes from deploy.sh (--env-vars-file + Secret Manager)
.env
**/.env
**/*.env
.env.yaml
**/.env.yaml
.env.example
**/.env.example

# Tests and coverage (not used in production)
**/*.test.ts
**/*.spec.ts
test/
coverage/

# Dev-only tooling
*.log
jest.config.ts
.eslintrc*

# One-off local scripts (not Cloud Function entry points)
seed_*.ts
seed_*.js
verify_*.ts
verify_*.js
set_cors.ts
injectSwagger.js
src/server.ts

# Seed/migration scripts — only morningGreetings.json is imported at runtime
src/seed/*.ts

# lib/ is produced by `npm run build` before deploy (Cloud Build does not run tsc here)
