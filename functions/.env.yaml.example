# Copy to `.env.yaml` for local dev and deploy-time config (never commit `.env.yaml`).
# Twilio/R2 credentials belong in `.env` locally and Secret Manager in production.

FIREBASE_PROJECT_ID: "askwhatsappbot-5182e"
GOOGLE_CLOUD_PROJECT: "askwhatsappbot-5182e"
NODE_ENV: "production"

TWILIO_WEBHOOK_BASE_URL: "https://us-central1-askwhatsappbot-5182e.cloudfunctions.net/whatsappWebhook"
# TWILIO_STATUS_CALLBACK_URL: "https://us-central1-askwhatsappbot-5182e.cloudfunctions.net/whatsappWebhook/status"
# TWILIO_TYPING_STATE_WEBHOOK_URL: ""

PUBSUB_TOPIC_MORNING_SEND: "morning-send-topic"
PUBSUB_TOPIC_REMINDER_SEND: "reminder-send-topic"
PUBSUB_TOPIC_QUEST_SEND: "quest-send-topic"

# Twilio Content Template SIDs (public identifiers, not auth secrets)
# TWILIO_CONTENT_SID_MORNING_DEVOTION: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_REGISTRATION_COMPLETE: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUIZ_RESPONSE: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_KNOCK_RESPONSE: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ask_seek_declaration quick-reply
# TWILIO_CONTENT_SID_KNOCK_THEME_CONFIRM: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUEST_MONDAY: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUEST_TUESDAY: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUEST_WEDNESDAY: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUEST_FRIDAY: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_QUEST_SATURDAY: "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 non-secret config (keys in `.env` / Secret Manager)
# R2_ACCOUNT_ID: "your-r2-account-id"
# R2_BUCKET_NAME: "your-bucket"
# R2_PUBLIC_URL: "cdn.example.com"

# Production dashboard only. For local dev add: ,http://localhost:3000
# ALLOWED_ADMIN_ORIGINS: "https://dashboard.askadonai.com"

# Password-reset redirect + email links
# DASHBOARD_URL: "https://dashboard.askadonai.com"
# RESEND_FROM_EMAIL: "Ask Adonai Admin <noreply@askadonai.com>"
