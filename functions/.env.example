# Copy to `.env` — secrets only. Production values go in GCP Secret Manager.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Optional API key auth for REST sends (webhook validation still uses TWILIO_AUTH_TOKEN)
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
#
# twilioCredentials.test.ts reads the vars above from `.env` when present (skipped in CI without them).

# Cloudflare R2 (admin media uploads) — keys in Secret Manager for production
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Resend (transactional email — password reset, etc.)
RESEND_API_KEY=re_your_api_key

# Local dev only — never set in production
# TWILIO_WEBHOOK_SKIP_SIGNATURE_VALIDATION=true
