{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DailyDeclaration": {
      "additionalProperties": false,
      "description": "dailyDeclarations/{dateString}\n\nRepresents a scheduled daily declaration for the KNOCK flow. Document ID is the YYYY-MM-DD string format in the target timezone.",
      "properties": {
        "audioUrl": {
          "type": "string"
        },
        "bibleVerse": {
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "date": {
          "type": "string"
        },
        "declarationText": {
          "type": "string"
        },
        "mediaId": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "date",
        "mediaId",
        "audioUrl"
      ],
      "type": "object"
    },
    "DeclarationLog": {
      "additionalProperties": false,
      "description": "users/{phone}/declarations/{YYYY-MM-DD}\n\nOne document per day — tracks how many times the user declared and the full text of the declaration for that day.",
      "properties": {
        "count": {
          "type": "number"
        },
        "declarationText": {
          "type": "string"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "timestamps",
        "declarationText"
      ],
      "type": "object"
    },
    "DeliveryLog": {
      "additionalProperties": false,
      "description": "deliveryLogs/{logId}\n\nOperational log of every outbound message attempt. Derived from scheduler runs, Twilio retries, and worker outcomes. Used for debugging, retry analysis, and Twilio delivery tracking.\n\nlogId convention: auto-generated Firestore ID (addDoc)",
      "properties": {
        "error": {
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "sent",
            "failed",
            "skipped"
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "ASK",
            "SEEK",
            "KNOCK",
            "JOURNAL",
            "NEED",
            "QUEST",
            "WATCH",
            "QUIZ",
            "PROGRESS",
            "MORNING_CARD",
            "REMINDER",
            "CHECKIN"
          ],
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "type",
        "status",
        "sentAt"
      ],
      "type": "object"
    },
    "FirebaseFirestore.Timestamp": {
      "additionalProperties": false,
      "description": "A Timestamp represents a point in time independent of any time zone or calendar, represented as seconds and fractions of seconds at nanosecond resolution in UTC Epoch time. It is encoded using the Proleptic Gregorian Calendar which extends the Gregorian calendar backwards to year one. It is encoded assuming all minutes are 60 seconds long, i.e. leap seconds are \"smeared\" so that no leap second table is needed for interpretation. Range is from 0001-01-01T00:00:00Z to 9999-12-31T23:59:59.999999999Z.",
      "properties": {
        "nanoseconds": {
          "description": "The non-negative fractions of a second at nanosecond resolution.",
          "type": "number"
        },
        "seconds": {
          "description": "The number of seconds of UTC time since Unix epoch 1970-01-01T00:00:00Z.",
          "type": "number"
        }
      },
      "required": [
        "seconds",
        "nanoseconds"
      ],
      "type": "object"
    },
    "JournalEntry": {
      "additionalProperties": false,
      "description": "users/{phone}/journal/{YYYY-MM-DD}\n\nOne document per day. The date key is the user's local calendar date.",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "response": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "verse": {
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "response",
        "verse",
        "theme",
        "timestamp"
      ],
      "type": "object"
    },
    "JourneyStage": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "type": "number"
    },
    "Media": {
      "additionalProperties": false,
      "description": "media/{mediaId}\n\nRepresents an uploaded file (audio, image, video) in the Cloudflare R2 bucket.",
      "properties": {
        "categoryIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "audio",
            "image",
            "video"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "url",
        "filename",
        "tags",
        "categoryIds"
      ],
      "type": "object"
    },
    "MediaCategory": {
      "additionalProperties": false,
      "description": "mediaCategories/{categoryId}\n\nRepresents a category for grouping media files (e.g. \"thanksgiving\", \"morning devotion\").",
      "properties": {
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "description": "milestones/{milestoneId}\n\nMilestone progression messages shown to users as they hit streak or vine thresholds. The system checks against User.streak and User.vineStage after each daily send.\n\nmilestoneId convention: \"streak-{n}\" or \"vine-{stage}\" e.g. \"streak-7\", \"vine-Rooted\"",
      "properties": {
        "message": {
          "type": "string"
        },
        "streak": {
          "type": "number"
        },
        "vineStage": {
          "type": "string"
        }
      },
      "required": [
        "streak",
        "vineStage",
        "message"
      ],
      "type": "object"
    },
    "PendingUser": {
      "additionalProperties": false,
      "description": "Minimal user document created while onboarding is still in progress. The full User shape is only guaranteed after the time step finalises.",
      "properties": {
        "awaitingOnboardingStep": {
          "enum": [
            "name",
            "timezone",
            "time"
          ],
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "phone",
        "awaitingOnboardingStep",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "PrayerCard": {
      "additionalProperties": false,
      "description": "prayerCards/{cardId}\n\nJourney routing card. Indexed by journeyStage + dayIndex. Prayer content is resolved from prayerThemes/{themeId}/prayers/{prayerId}.\n\ncardId convention: \"stage{n}-day{m}\" e.g. \"stage1-day3\"",
      "properties": {
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "dayIndex": {
          "type": "number"
        },
        "devotionLink": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "journalPrompt": {
          "type": "string"
        },
        "journeyStage": {
          "$ref": "#/definitions/JourneyStage"
        },
        "morningVoiceNoteUrl": {
          "type": "string"
        },
        "prayerId": {
          "type": "string"
        },
        "themeId": {
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "journeyStage",
        "dayIndex",
        "themeId",
        "prayerId",
        "imageUrl",
        "morningVoiceNoteUrl",
        "devotionLink",
        "journalPrompt"
      ],
      "type": "object"
    },
    "PrayerTheme": {
      "additionalProperties": false,
      "description": "prayerThemes/{themeId}\n\nPrayer categories. Users select a theme via the NEED keyword, and Journey cards reference prayers inside these themes. Prayers live in the sub-collection: prayerThemes/{themeId}/prayers/{prayerId}",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "displayName": {
          "type": "string"
        },
        "menuOrder": {
          "type": "number"
        },
        "themeId": {
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "themeId",
        "displayName",
        "category",
        "menuOrder",
        "available"
      ],
      "type": "object"
    },
    "QuestContent": {
      "additionalProperties": false,
      "description": "questContent/{weekNumber}\n\nQuest curriculum — one document per week (1-52). The document ID is the week number as a string: \"1\", \"2\" … \"52\".",
      "properties": {
        "days": {
          "additionalProperties": false,
          "properties": {
            "friday": {
              "additionalProperties": false,
              "properties": {
                "fridayEncouragement": {
                  "type": "string"
                },
                "readingPortion": {
                  "type": "string"
                },
                "videoLink": {
                  "type": "string"
                },
                "weeklySummary": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "monday": {
              "additionalProperties": false,
              "properties": {
                "mondayEncouragement": {
                  "type": "string"
                },
                "readingPortion": {
                  "type": "string"
                },
                "videoLink": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "saturday": {
              "additionalProperties": false,
              "properties": {
                "quizGreeting": {
                  "type": "string"
                },
                "quizLinks": {
                  "type": "string"
                },
                "saturdayEncouragement": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "sunday": {
              "additionalProperties": false,
              "properties": {
                "sundaySummary": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "thursday": {
              "additionalProperties": false,
              "properties": {
                "readingPortion": {
                  "type": "string"
                },
                "thursdaySummary": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "tuesday": {
              "additionalProperties": false,
              "properties": {
                "reflectionQuote": {
                  "type": "string"
                },
                "tuesdaySummary": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "wednesday": {
              "additionalProperties": false,
              "properties": {
                "estimatedTime": {
                  "type": "string"
                },
                "readingPortion": {
                  "type": "string"
                },
                "signOff": {
                  "type": "string"
                },
                "videoLink": {
                  "type": "string"
                },
                "wednesdaySummary": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "introImageUrl": {
          "type": "string"
        },
        "levelTracker": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ],
          "type": "string"
        },
        "weekIntro": {
          "type": "string"
        },
        "weekNumber": {
          "type": "number"
        },
        "weeklyChapterSpan": {
          "type": "string"
        }
      },
      "required": [
        "weekNumber",
        "status",
        "introImageUrl",
        "days"
      ],
      "type": "object"
    },
    "QuestLog": {
      "additionalProperties": false,
      "description": "users/{phone}/questLog/{YYYY-MM-DD}\n\nOne document per day — tracks quest interactions for that calendar date. Used for the PROGRESS summary and FlutterFlow activity feeds.",
      "properties": {
        "chaptersLogged": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "videosWatched": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "chaptersLogged",
        "videosWatched"
      ],
      "type": "object"
    },
    "SystemConfig": {
      "additionalProperties": false,
      "description": "systemConfig/{configId}\n\nGlobal settings and configuration for the bot. The primary document is typically systemConfig/global.",
      "properties": {
        "needMenuImageUrl": {
          "description": "The URL of the image to send when a user requests the NEED menu. If not provided, the bot will fall back to sending a text-based menu.",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "updatedAt"
      ],
      "type": "object"
    },
    "ThemePrayer": {
      "additionalProperties": false,
      "description": "prayerThemes/{themeId}/prayers/{prayerId}\n\nIndividual prayer entries within a reusable prayer theme. Fetched sequentially by index — User.needPrayerIndex tracks the position.\n\nprayerId convention: \"prayer-{index}\" e.g. \"prayer-1\", \"prayer-2\"",
      "properties": {
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "declarationAudioUrl": {
          "type": "string"
        },
        "declarationText": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "prayerText": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "reflectionQuestion": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirebaseFirestore.Timestamp"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "verse": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "prayerText",
        "declarationText",
        "declarationAudioUrl",
        "verse",
        "reference",
        "reflectionQuestion",
        "index"
      ],
      "type": "object"
    },
    "User": {
      "additionalProperties": false,
      "description": "users/{phoneNumber}\n\nCore user document. The document ID IS the phone number (E.164, e.g. +2348012345678). All NEED and Quest state lives here — no separate collections for runtime state.\n\nSub-collections:   users/{phone}/journal/{YYYY-MM-DD}        → JournalEntry   users/{phone}/declarations/{YYYY-MM-DD}   → DeclarationLog   users/{phone}/questLog/{YYYY-MM-DD}       → QuestLog",
      "properties": {
        "activeNeedTheme": {
          "type": "string"
        },
        "awaitingDeclarationYes": {
          "type": "boolean"
        },
        "awaitingJournal": {
          "type": "boolean"
        },
        "awaitingNeedSelection": {
          "type": "boolean"
        },
        "awaitingOnboardingStep": {
          "enum": [
            "name",
            "timezone",
            "time",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "awaitingQuestConfirm": {
          "type": "boolean"
        },
        "awaitingQuizAnswer": {
          "type": "boolean"
        },
        "awaitingReminderTime": {
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "currentQuizQuestionIndex": {
          "type": "number"
        },
        "currentQuizScore": {
          "type": "number"
        },
        "declarationsToday": {
          "type": "number"
        },
        "eveningReminderSentToday": {
          "type": "boolean"
        },
        "joinedAt": {
          "format": "date-time",
          "type": "string"
        },
        "journaledToday": {
          "type": "boolean"
        },
        "journeyDayIndex": {
          "type": "number"
        },
        "journeyStage": {
          "$ref": "#/definitions/JourneyStage"
        },
        "lastActiveDate": {
          "type": "string"
        },
        "lastCheckinSent": {
          "type": "string"
        },
        "lastMorningDeliveryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastQuestDeliveryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastReminderDeliveryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lockedUntil": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "needPrayerIndex": {
          "type": "number"
        },
        "nextQuestAt": {
          "format": "date-time",
          "type": "string"
        },
        "nextReminderAt": {
          "format": "date-time",
          "type": "string"
        },
        "nextSendAt": {
          "format": "date-time",
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "phone": {
          "type": "string"
        },
        "questActive": {
          "type": "boolean"
        },
        "questChaptersLogged": {
          "type": "number"
        },
        "questVideoIndex": {
          "type": "number"
        },
        "questWeek": {
          "type": "number"
        },
        "reminderTime": {
          "type": "string"
        },
        "reminderTimeLocal": {
          "type": "string"
        },
        "reminderTimeUTC": {
          "type": "string"
        },
        "streak": {
          "type": "number"
        },
        "timezone": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "vineStage": {
          "enum": [
            "Grafted",
            "Rooted",
            "Growing",
            "Blooming",
            "Fruitful"
          ],
          "type": "string"
        }
      },
      "required": [
        "phone",
        "name",
        "reminderTime",
        "reminderTimeLocal",
        "timezone",
        "reminderTimeUTC",
        "nextSendAt",
        "nextReminderAt",
        "nextQuestAt",
        "lockedUntil",
        "journeyStage",
        "journeyDayIndex",
        "vineStage",
        "streak",
        "lastActiveDate",
        "declarationsToday",
        "journaledToday",
        "eveningReminderSentToday",
        "lastCheckinSent",
        "paused",
        "awaitingJournal",
        "awaitingNeedSelection",
        "awaitingOnboardingStep",
        "awaitingQuestConfirm",
        "awaitingQuizAnswer",
        "awaitingDeclarationYes",
        "awaitingReminderTime",
        "activeNeedTheme",
        "needPrayerIndex",
        "questActive",
        "questWeek",
        "questVideoIndex",
        "questChaptersLogged",
        "currentQuizQuestionIndex",
        "currentQuizScore",
        "lastMorningDeliveryId",
        "lastReminderDeliveryId",
        "lastQuestDeliveryId",
        "joinedAt",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    }
  }
}